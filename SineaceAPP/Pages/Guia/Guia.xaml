<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SineaceAPP.Pages.Guia.Guia"
             Title="Guia" BackgroundColor="#B3000000">
    <Grid>

        <Grid.RowDefinitions>
            <!--<RowDefinition Height="7*" />-->
            <RowDefinition Height="20*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <CarouselView Grid.Row="0" x:Name="carrucleView" IndicatorView="indicatorView" CurrentItemChanged="carrucleView_CurrentItemChanged" BackgroundColor="Transparent" Margin="20,40,20,0">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" BorderColor="White" CornerRadius="30" HasShadow="True" Margin="20,0,20,0">
                        <VerticalStackLayout Padding="10"  VerticalOptions="Start" Margin="20,0,20,0">
                            <Label FontSize="28"  Margin="0,0,0,10" FontFamily="poppinsbold" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#04acec" Text="{Binding Titulo}" IsVisible="{Binding TituloVisible}"/>
                            <Label FontSize="18"  Margin="0,10,0,0" FontFamily="robotolight" FontAttributes="Bold"  Text="{Binding Descripcion1}" IsVisible="{Binding Descripcion1Visible}"/>
                            <VerticalStackLayout IsVisible="{Binding Descripcion2Visible}">
                                <HorizontalStackLayout>
                                    <Image  Source="iconos_11.png" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" />
                                    <Label FontSize="14"  Margin="0,0,0,0" FontFamily="poppinsbold" FontAttributes="Bold"  Text="Universidades (azul): "/>
                                </HorizontalStackLayout>
                                <Label FontSize="14"  Margin="0,0,0,10" FontFamily="robotolight" FontAttributes="Bold"  Text="Universidades que tienen como mínimo un programa de estudio acreditado y vigente."/>
                                <HorizontalStackLayout>
                                    <Image  Source="iconos_01.png" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" />
                                    <Label FontSize="14"  Margin="0,0,0,0" FontFamily="poppinsbold" FontAttributes="Bold"  Text="Institutos (verde): "/>
                                </HorizontalStackLayout>
                                <Label FontSize="14"  Margin="0,0,0,10" FontFamily="robotolight" FontAttributes="Bold"  Text="Institutos que tienen como mínimo un programa de estudio acreditado y vigente."/>
                                <HorizontalStackLayout>
                                    <Image  Source="iconos_09.png" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" />
                                    <Label FontSize="14"  Margin="0,0,0,0" FontFamily="poppinsbold" FontAttributes="Bold"  Text="Escuelas de la FFAA (rojo): "/>
                                </HorizontalStackLayout>
                                <Label FontSize="14"  Margin="0,0,0,10" FontFamily="robotolight" FontAttributes="Bold"  Text="Escuelas de la FFAA que tienen como mínimo un programa de estudio acreditado y vigente."/>
                            </VerticalStackLayout>
                            <Image Source="{Binding imgRuta}" Aspect="AspectFit" HeightRequest="230" Margin="0,30,0,0" HorizontalOptions="Center" BackgroundColor="Transparent" IsVisible="{Binding Descripcion3Visible}"></Image>
                            <Image Source="{Binding imgRuta}" Aspect="AspectFit" HeightRequest="390" Margin="0,30,0,0" HorizontalOptions="Center" BackgroundColor="Transparent" IsVisible="{Binding Descripcion4Visible}"></Image>
                            <Button x:Name="btnSiguiente"  Clicked="btnSiguiente_Clicked" Text="Siguiente" WidthRequest="200" Margin="0,10,0,0" HeightRequest="45" CornerRadius="25" FontFamily="Poppinbold" FontSize="18" BackgroundColor="#04acec"></Button>
                            <Button x:Name="btnComenzar"  Clicked="btnComenzar_Clicked" Text="¡Comenzar!" IsVisible="false" WidthRequest="200" Margin="0,10,0,0" HeightRequest="45" CornerRadius="25" FontFamily="Poppinbold" FontSize="18" BackgroundColor="#04acec"></Button>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <IndicatorView Grid.Row="1" x:Name="indicatorView" Margin="0,10,0,0" HorizontalOptions="Center" IndicatorColor="#CBCBCB" SelectedIndicatorColor="#ccd424" IndicatorSize="12" />
    </Grid>
</ContentPage>