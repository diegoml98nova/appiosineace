<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="SineaceAPP.Pages.Inicio.InicioCarrucel"
             BackgroundImageSource="fondo_sineace3.png"
             Title="sineace">
    <Grid>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Image  Grid.Row="0" Aspect="AspectFill" Source="fondo_sineace3.png"></Image>
        <CarouselView Grid.Row="0" x:Name="carrucleView" IndicatorView="indicatorView" CurrentItemChanged="carrucleView_CurrentItemChanged">
            <!--<CarouselView.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Item1</x:String>
                    <x:String>Item2</x:String>
                    <x:String>Item3</x:String>
                    <x:String>Item4</x:String>
                </x:Array>
                         
            </CarouselView.ItemsSource>-->
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10"  VerticalOptions="End">
                        <!--<Image Source="logocalado.png" Margin="0,0,0,10" WidthRequest="230" IsVisible="{Binding ImgVisible}"></Image>-->
                        <Image Source="logocalado.png"  WidthRequest="230" HeightRequest="140" Margin="0,80,0,0" HorizontalOptions="Center" BackgroundColor="Transparent" IsVisible="{Binding ImgVisible}"></Image>
                        <Label x:Name="lblTitulo" FontSize="26"  Margin="10,40,10,10" FontFamily="Poppinbold" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#04acec" Text="{Binding Titulo}" IsVisible="{Binding TituloVisible}"/>
                        <Label FontSize="14"  Margin="10,10,10,10" FontFamily="poppinslight" FontAttributes="Bold"  Text="{Binding Descripcion1}" IsVisible="{Binding Descripcion1Visible}"/>
                        <Label FontSize="15"  Margin="10,10,10,0" FontFamily="Poppinbold" FontAttributes="Bold" TextColor="#04acec" Text="{Binding SubTitulo}" IsVisible="{Binding SubTituloVisible}"/>
                        <Label FontSize="14"  Margin="10,10,10,10" FontFamily="poppinslight" FontAttributes="Bold"  Text="{Binding Descripcion2}" IsVisible="{Binding Descripcion2Visible}"/>
                        <Label FontSize="14"  Margin="20,10,10,10" FontFamily="poppinslight" FontAttributes="Bold"  Text="{Binding Descripcion3}" IsVisible="{Binding Descripcion3Visible}"/>
                        <Label FontSize="14"  Margin="20,10,10,10" FontFamily="poppinslight" FontAttributes="Bold"  Text="{Binding Descripcion4}" IsVisible="{Binding Descripcion4Visible}"/>
                        <Label FontSize="14"  Margin="20,10,10,10" FontFamily="poppinslight" FontAttributes="Bold"  Text="{Binding Descripcion5}" IsVisible="{Binding Descripcion5Visible}"/>
                        <Label FontSize="14"  Margin="20,10,10,10" FontFamily="poppinslight" FontAttributes="Bold"  Text="{Binding Descripcion6}" IsVisible="{Binding Descripcion6Visible}"/>
                        <Label FontSize="14"  Margin="20,10,10,10" FontFamily="poppinslight" FontAttributes="Bold"  Text="{Binding Descripcion7}" IsVisible="{Binding Descripcion7Visible}"/>
                        <Button x:Name="btnComencemos" Clicked="btnComencemos_Clicked" Text="Comencemos" Opacity="{Binding ButtomVisible}" WidthRequest="200" Margin="0,50,0,0" HeightRequest="45" CornerRadius="25" FontFamily="Poppinbold" FontSize="18" BackgroundColor="#04acec"></Button>
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <Button x:Name="btnOmitir" Grid.Row="1" IsVisible="false" Text="Omitir" Clicked="btnComencemos_Clicked"  WidthRequest="180" Margin="0,0,0,0" HeightRequest="60" CornerRadius="30" FontFamily="robotobold" FontSize="20" BackgroundColor="#9b9b9b"></Button>
        <IndicatorView Grid.Row="2" x:Name="indicatorView" Margin="5" HorizontalOptions="Center" IndicatorColor="#CBCBCB" SelectedIndicatorColor="#ccd424" IndicatorSize="11"/>
        <AbsoluteLayout x:Name="alPantallaCarga" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="#99FFFFFF" IsVisible="false">
            <AbsoluteLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Margin="120,250,0,0" >
            <Image x:Name="img1"  AbsoluteLayout.LayoutBounds="15, 60, 0, 0" Source="colibri_ala_izq.png" HeightRequest="100" BackgroundColor="Transparent" WidthRequest="100" Margin="0,0,0,0" HorizontalOptions="Start"  />
            <Image x:Name="img2"  AbsoluteLayout.LayoutBounds="35, 60, 0, 0" IsVisible="false" Source="colibri_ala_izq_2.png" HeightRequest="100" BackgroundColor="Transparent" WidthRequest="100" Margin="0,0,0,0" HorizontalOptions="Start"  />
            <Image x:Name="img3"  AbsoluteLayout.LayoutBounds="10, 70, 0, 0"  IsVisible="false" Source="colibri_ala_izq_3.png" HeightRequest="100" BackgroundColor="Transparent" WidthRequest="100" Margin="0,0,0,0" HorizontalOptions="Start"  />
            <Image  AbsoluteLayout.LayoutBounds="60, 116, 0, 0"  Source="colibri_ala_cuerpo.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start" />
            <Image x:Name="imgd1"  AbsoluteLayout.LayoutBounds="90, 140, 0,0" Source="colibri_ala_der.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"  />
            <Image x:Name="imgd2"  AbsoluteLayout.LayoutBounds="100, 130, 0,0" IsVisible="false" Source="colibri_ala_der_2.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"  />
            <Image x:Name="imgd3"  AbsoluteLayout.LayoutBounds="70, 140, 0,10" IsVisible="false" Source="colibri_ala_der_3.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"  />
        </AbsoluteLayout>
        </AbsoluteLayout>
    </Grid>
    

</ContentPage>