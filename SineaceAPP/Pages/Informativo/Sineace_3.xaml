<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SineaceAPP.Pages.Informativo.Sineace_3"
             Title="Sineace_3">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="17*" />
            <!--<RowDefinition Height="2*" />-->
        </Grid.RowDefinitions>

        <Image Grid.Row="1" Aspect="AspectFill" Source="fondo_sineace3.png"></Image>
        <HorizontalStackLayout Grid.Row="0" BackgroundColor="#04acec" Padding="25,15,25,15">
            <ImageButton x:Name="btnAtras" Source="atras2.png" WidthRequest="40" HeightRequest="40" Clicked="btnAtras_Clicked"></ImageButton>
            <Label Text="" TextColor="White" FontSize="36" FontFamily="robotobold" Margin="15,0,0,0"></Label>
        </HorizontalStackLayout>
        <!--<CarouselView Grid.Row="1" x:Name="carrucleView" IndicatorView="indicatorView" CurrentItemChanged="carrucleView_CurrentItemChanged" >
            <CarouselView.ItemTemplate>
                <DataTemplate>-->
        <VerticalStackLayout  Grid.Row="1" Padding="10,20,10,10" >
            <Label x:Name="lbl1" FontSize="26" Margin="10,40,10,0" FontFamily="Poppinbold" TextColor="#04acec" Text="{Binding Titulo}" IsVisible="{Binding TituloVisible}"/>
            <Label x:Name="lbl2" FontSize="33" Margin="10,0,10,10" FontFamily="Poppinbold" TextColor="#04acec" Text="{Binding SubTitulo1}" IsVisible="{Binding SubTitulo1Visible}"/>
            <Label x:Name="lbl3" FontSize="14" Margin="10,10,10,10" FontFamily="poppinslight" Text="{Binding Descripcion1}" IsVisible="{Binding Descripcion1Visible}"/>
            <Label x:Name="lbl4" FontSize="14" Margin="10,10,10,10" FontFamily="poppinslight" Text="{Binding Descripcion2}" IsVisible="{Binding Descripcion2Visible}"/>
            <Label x:Name="lbl5" FontSize="14" Margin="10,10,10,10" FontFamily="poppinslight" Text="{Binding Descripcion3}" IsVisible="{Binding Descripcion3Visible}"/>
            <VerticalStackLayout Padding="10,0,10,10">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"></TapGestureRecognizer>
                </VerticalStackLayout.GestureRecognizers>
            <Label BackgroundColor="Transparent" TextColor="#04acec" Text="https://app.sineace.gob.pe/sigice/padrones/frminicio.aspx" FontFamily="poppinslight" FontSize="14" ></Label>
            </VerticalStackLayout>
        </VerticalStackLayout>
        <!--</DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>-->
        <!--<IndicatorView Grid.Row="2" x:Name="indicatorView" Margin="5" HorizontalOptions="Center" IndicatorColor="#CBCBCB" SelectedIndicatorColor="#ccd424" IndicatorSize="11"/>-->

    </Grid>
</ContentPage>