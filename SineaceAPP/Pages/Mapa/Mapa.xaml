                <ImageButton x:Name="btnFiltro" Clicked="btnFiltro_Clicked" VerticalOptions="Start" HorizontalOptions="End" Margin="0,31,35,0" HeightRequest="27" WidthRequest="27" Source="ic_baseline_filterpng.png"/>
                <!--Arriba-->

                <Frame x:Name="FlexLayout"
                       CornerRadius="10" 
                       TranslationX="10"
                       AbsoluteLayout.LayoutFlags="PositionProportional"
                       HeightRequest="180"
                       WidthRequest="250"
                       Margin="0,0,0,80"
                       Padding="0,20,20,20"
                   VerticalOptions="End"
                   HorizontalOptions="End"
                       >

                    <StackLayout Orientation="Horizontal" >
                        <!--<BoxView Color="Red" WidthRequest="10" />-->
                        <!--<BoxView Color="Yellow" WidthRequest="220"/>-->
                        <StackLayout  Orientation="Horizontal" WidthRequest="35" >
                            <ImageButton x:Name="btnCerrarLeyenda" BackgroundColor="Transparent"
                            HeightRequest="27"
                            WidthRequest="27"
                            Source="ic_baseline_keyboard_arrow_right.png"
                                         Clicked="btnCerrarLeyenda_Clicked"/>

                            <ImageButton x:Name="btnAbrirLeyenda"
                            HeightRequest="27"
                            WidthRequest="27"
                             IsVisible="false"
                            Source="ic_baseline_keyboard_arrow_left.png"
                                         Clicked="btnAbrirLeyenda_Clicked"/>
                        </StackLayout>

                        <StackLayout  Orientation="Vertical" WidthRequest="200">
                            <Label x:Name="lblLeyendaTitulo" Text="Programa acreditados" FontSize="15"></Label>
                            <StackLayout  Orientation="Horizontal" WidthRequest="200" HeightRequest="20"  Margin="0,10,0,20">
                                <Image  Source="iconos_11.png"
                                        HeightRequest="32"
                                        WidthRequest="32"
                                        HorizontalOptions="Center" />
                                <Label Text="De universidades: (62)" FontSize="15"></Label>
                            </StackLayout>
                            <StackLayout  Orientation="Horizontal" WidthRequest="200" HeightRequest="20"  Margin="0,0,0,20">
                                <Image  Source="iconos_01.png"
                                        HeightRequest="32"
                                        WidthRequest="32"
                                        HorizontalOptions="Center" />
                                <Label Text="De institutos: (54)" FontSize="15"></Label>
                            </StackLayout>
                            <StackLayout  Orientation="Horizontal" WidthRequest="200" HeightRequest="20"  Margin="0,0,0,20">
                                <Image  Source="iconos_09.png"
                                        HeightRequest="32"
                                        WidthRequest="32"
                                        HorizontalOptions="Center" />
                                <Label Text="De escuelas FF.AA.: (7)" FontSize="15"></Label>
                            </StackLayout>


                        </StackLayout>
                    </StackLayout>


                </Frame>


            </Grid>
            <Grid Grid.Row="0" x:Name="grid1" RowDefinitions="Auto,Auto" HeightRequest="10" VerticalOptions="Start" HorizontalOptions="Start" Margin="70,90,0,0">
                <CollectionView  Grid.Row="0" x:Name="MyCollectionViews" ItemsSource="{Binding AutoCompleteDetalle}" VerticalOptions="Start">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout  Orientation="Vertical" Span="1" VerticalItemSpacing="8"></GridItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="20,0,20,10">
                                <Frame BackgroundColor="White" BorderColor="White" CornerRadius="10" HasShadow="True" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" CommandParameter="{Binding Cordenadas}"></TapGestureRecognizer>
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="CenterAndExpand" >
                                        <Label VerticalOptions="CenterAndExpand" Text="{Binding Programa}" TextColor="#04acec" FontSize="16"/>
                                        <Label VerticalOptions="CenterAndExpand" Text="{Binding Universidad}" TextColor="#7c7c80" FontSize="14"/>
                                        <Label VerticalOptions="CenterAndExpand" Text="{Binding Direccion}" TextColor="#7c7c80" FontSize="14"/>
                                        <Label VerticalOptions="CenterAndExpand" Text="{Binding TipoPrograma}" TextColor="#7c7c80" FontSize="14"/>
                                        <Grid RowDefinitions="Auto,Auto">
                                            <Label Grid.Column="0" HorizontalOptions="Start" Text="{Binding Distancia}" TextColor="#04acec" FontSize="16" />
                                            <Label Grid.Column="1" HorizontalOptions="End" Text="{Binding Estado}" TextColor="#04ac04" FontSize="14" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            
            <AbsoluteLayout x:Name="alPantallaCarga" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="#99FFFFFF" IsVisible="false">
                <AbsoluteLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Margin="120,250,0,0" >
                    <Image x:Name="img1"  AbsoluteLayout.LayoutBounds="15, 60, 0, 0" Source="colibri_ala_izq.png" HeightRequest="100" BackgroundColor="Transparent" WidthRequest="100" Margin="0,0,0,0" HorizontalOptions="Start"  />
                    <Image x:Name="img2"  AbsoluteLayout.LayoutBounds="35, 60, 0, 0" IsVisible="false" Source="colibri_ala_izq_2.png" HeightRequest="100" BackgroundColor="Transparent" WidthRequest="100" Margin="0,0,0,0" HorizontalOptions="Start"  />
                    <Image x:Name="img3"  AbsoluteLayout.LayoutBounds="10, 70, 0, 0"  IsVisible="false" Source="colibri_ala_izq_3.png" HeightRequest="100" BackgroundColor="Transparent" WidthRequest="100" Margin="0,0,0,0" HorizontalOptions="Start"  />
                    <Image  AbsoluteLayout.LayoutBounds="60, 116, 0, 0"  Source="colibri_ala_cuerpo.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start" />
                    <Image x:Name="imgd1"  AbsoluteLayout.LayoutBounds="90, 140, 0,0" Source="colibri_ala_der.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"  />
                    <Image x:Name="imgd2"  AbsoluteLayout.LayoutBounds="100, 130, 0,0" IsVisible="false" Source="colibri_ala_der_2.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"  />
                    <Image x:Name="imgd3"  AbsoluteLayout.LayoutBounds="70, 140, 0,10" IsVisible="false" Source="colibri_ala_der_3.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Start"  />
                </AbsoluteLayout>
            </AbsoluteLayout>
            <Grid Grid.Row="0" VerticalOptions="FillAndExpand" BackgroundColor="Transparent" WidthRequest="10" HorizontalOptions="Start">
            </Grid>
        </Grid>
       

    </StackLayout>
</ContentPage>

