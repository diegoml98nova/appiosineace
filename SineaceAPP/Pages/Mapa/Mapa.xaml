<?xml version="1.0" encoding="utf-8" ?>
<ContentPage NavigationPage.HasNavigationBar="False"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="SineaceAPP.Pages.Mapa.Mapa"
             Title="Map properties demo">
    <StackLayout >
        <Grid VerticalOptions="FillAndExpand">
 
            <Grid Grid.Row="0" VerticalOptions="FillAndExpand">
                <maps:Map x:Name="map" Margin="0,0,0,0">
                    
                </maps:Map>
                    <!--Abajo izquierda-->
                <Button VerticalOptions="End" HorizontalOptions="Start" HeightRequest="100" WidthRequest="100" CornerRadius="50" Margin="2,0,0,10" BackgroundColor="#e4ecec"/>
                <Button VerticalOptions="End" HorizontalOptions="Start" HeightRequest="80" WidthRequest="80" CornerRadius="40" Margin="12,10,10,20" BackgroundColor="white" FontFamily="robotoblack" Text="" TextColor="#04acec" FontSize="17"/>
                <Label VerticalOptions="End" HorizontalOptions="Start" Margin="40,20,20,30"  AbsoluteLayout.LayoutBounds="0, 1, AutoSize, AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" FontFamily="robotoblack"  FontSize="17" TextColor="#04acec" Text="KM" ></Label>
                <Label VerticalOptions="End" HorizontalOptions="Start" x:Name="lblDistancia" Margin="20,20,20,50" WidthRequest="60" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" AbsoluteLayout.LayoutBounds="0, 1, AutoSize, AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" FontFamily="robotoblack"  FontSize="28" TextColor="#04acec" Text="-" ></Label>
                <!--Abajo izquierda-->

                <!--Abajo derecha-->
                <Button VerticalOptions="End" HorizontalOptions="End" HeightRequest="50" WidthRequest="50" CornerRadius="25" Margin="12.5" BackgroundColor="White" Text="" TextColor="Black" FontSize="40"></Button>
                <ImageButton x:Name="btnMiUbicacion" VerticalOptions="End" HorizontalOptions="End" Source="currentlocationpng3.png" HeightRequest="20" WidthRequest="20" Margin="15" SemanticProperties.HeadingLevel="Level1"/>
                <!--Abajo derecha-->

                <!--Arriba-->
                <Rectangle VerticalOptions="Start" HorizontalOptions="Start" AbsoluteLayout.LayoutBounds="0, 20, 0, 40"  Fill="#FF00ADEB" StrokeThickness="50" RadiusX="100" RadiusY="100" WidthRequest="105" HeightRequest="105"/>
                <ImageButton x:Name="btnMenu" Clicked="btnMenu_Clicked" VerticalOptions="Start" HorizontalOptions="Start" Margin="25,24,0,0"  HeightRequest="55" WidthRequest="55" Source="ic_iconos_03_menu.png"/>
                <AbsoluteLayout VerticalOptions="Start" HorizontalOptions="Fill" Margin="65,0,0,0" HeightRequest="105" MaximumHeightRequest="105">
                    <Rectangle VerticalOptions="Start" HorizontalOptions="Fill" Margin="0,0,0,0" Fill="#FF00ADEB" StrokeThickness="50" RadiusX="200" RadiusY="200" HeightRequest="110" MaximumHeightRequest="110" AbsoluteLayout.LayoutBounds="0.5,0.5,1,1" AbsoluteLayout.LayoutFlags="All"/>
                </AbsoluteLayout>
                <ImageButton VerticalOptions="Start" HorizontalOptions="Start" Margin="100,31,0,0" HeightRequest="20" WidthRequest="20" Source="ic_baseline_searchpng2.png"/>

                <Grid RowDefinitions="Auto,Auto" HeightRequest="50" VerticalOptions="Start" HorizontalOptions="Start" Margin="140,28,0,0" WidthRequest="185">

                    <Entry x:Name="search" Grid.Row="0" Placeholder="Elige una carrera" VerticalOptions="Center" HorizontalOptions="Start" 
                           TextChanged="Entry_TextChanged" PlaceholderColor="White" TextColor="White"
                           WidthRequest="185"></Entry>


                </Grid>


