                                        <Label VerticalOptions="CenterAndExpand" Text="{Binding TipoPrograma}" TextColor="#7c7c80" FontSize="14"/>
                                        <Grid RowDefinitions="Auto,Auto">
                                            <Label Grid.Column="0" HorizontalOptions="Start" Text="{Binding Distancia}" TextColor="#04acec" FontSize="16" />
                                            <Label Grid.Column="1" HorizontalOptions="End" Text="{Binding Estado}" TextColor="#04ac04" FontSize="14" />
                                        </Grid>
                                    </VerticalStackLayout>
