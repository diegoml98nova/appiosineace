<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
             x:Class="SineaceAPP.Pages.Programas.ProgramasFiltros">
    <ScrollView>
        <Grid x:Name="MainContentGrid" RowDefinitions="auto, auto, auto" >
            <VerticalStackLayout>
                <HorizontalStackLayout BackgroundColor="#04acec" Padding="25,15,25,15">
                    <ImageButton x:Name="btnAtras" Source="atras2.png" WidthRequest="27" Clicked="btnAtras_Clicked" HeightRequest="27"></ImageButton>
                    <Label Text="Filtros" TextColor="White" FontSize="36" FontFamily="robotobold" Margin="15,0,0,0"></Label>
                </HorizontalStackLayout>

                <Label Text="Instituciones educativas"
                    TextColor="#04acec"
                    VerticalOptions="Start" 
                    HorizontalOptions="Start"
                    FontFamily="robotmedium"
                    FontSize="20"
                    Margin="40,10,10,5"/>
                <Border HeightRequest="70"
                    Margin="50,5,50,15"
                    StrokeThickness="0.5"
                    Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                            Offset="5,5"
                            Opacity="0.1" />
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout >
                        <ImageButton x:Name="btnChkIns1" Source="check2png.png" WidthRequest="40" Clicked="btnChkIns1_Clicked"></ImageButton>
                        <Label Text="Universidades" FontFamily="robotolight" TextColor="#707070" FontSize="20" Margin="10,0,0,0"></Label>
                    </HorizontalStackLayout>
                </Border>
                <!--</Frame>-->
                <Border HeightRequest="70"
                    Margin="50,5,50,15"
                    StrokeThickness="0.5"
                    Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                            Offset="5,5"
                            Opacity="0.1" />
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout >
                        <ImageButton x:Name="btnChkIns2" Source="check2png.png" WidthRequest="40" Clicked="btnChkIns2_Clicked"></ImageButton>
                        <Label Text="Instituciones" FontFamily="robotolight" TextColor="#707070" FontSize="20" Margin="10,0,0,0"></Label>
                    </HorizontalStackLayout>
                </Border>
                <Border HeightRequest="70"
                    Margin="50,5,50,5"
                    StrokeThickness="0.5"
                    Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black"
                            Offset="5,5"
                            Opacity="0.1" />
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout >
                        <ImageButton x:Name="btnChkIns3" Source="check2png.png" WidthRequest="40" Clicked="btnChkIns3_Clicked"></ImageButton>
                        <Label Text="Tipo de gestión" FontFamily="robotolight" TextColor="#707070" FontSize="20" Margin="10,0,0,0"></Label>
                    </HorizontalStackLayout>
                </Border>

                <Label Text="Tipo de gestión"
                    TextColor="#04acec"
                    VerticalOptions="Start" 
                    HorizontalOptions="Start"
                    FontFamily="robotmedium"
                    FontSize="20"
                    Margin="40,10,10,5"/>

                <Border HeightRequest="50"
                    Margin="50,0,50,0"
                    StrokeThickness="0"
                    Padding="20,20,20,0">

                    <HorizontalStackLayout >
                        <ImageButton x:Name="btnChkGes1" Source="check2png.png" WidthRequest="40" Clicked="btnChkGes1_Clicked"></ImageButton>
                        <Label Text="Pública" FontFamily="robotolight" TextColor="#707070" FontSize="20" Margin="10,0,0,0"></Label>
                    </HorizontalStackLayout>
                </Border>
                <Border HeightRequest="70"
                    Margin="50,0,50,0"
                    StrokeThickness="0"
                    Padding="20">

                    <HorizontalStackLayout >
                        <ImageButton x:Name="btnChkGes2" Source="check2png.png" WidthRequest="40" Clicked="btnChkGes2_Clicked"></ImageButton>
                        <Label Text="Privada" FontFamily="robotolight" TextColor="#707070" FontSize="20" Margin="10,0,0,0"></Label>
                    </HorizontalStackLayout>
                </Border>

                <Button x:Name="btnBuscar" Text="Buscar" Clicked="btnBuscar_Clicked" WidthRequest="190" HeightRequest="55" CornerRadius="20" FontFamily="Poppinsmedium" BackgroundColor="#ccd424" Margin="0,30,0,40" FontSize="18">
                    <Button.Shadow>
                        <Shadow Brush="Black"
                            Offset="5,5"
                            Opacity="0.3" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>

        </Grid>
    </ScrollView>
    </mopups:PopupPage>