<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SineaceAPP.Pages.Instituciones.InstitucionesProgramas"
             Title="InstitucionesProgramas" BackgroundColor="#99FFFFFF">
    <StackLayout>
        <HorizontalStackLayout Margin="11,24,0,0">
            <ImageButton x:Name="btnMenu" Clicked="btnMenu_Clicked" Grid.Column="0" Margin="14,0,0,0" VerticalOptions="Start" HorizontalOptions="Start" HeightRequest="55" WidthRequest="55" Source="ic_baseline_arrow_back_24_v2_azul.png"/>
            <Frame BackgroundColor="#04acec" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" WidthRequest="310" Background="#04acec" CornerRadius="30" BorderColor="#04acec" HeightRequest="55" Padding="15" Margin="10,0,0,0" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Text="Todas las instituciones" TextColor="White" FontFamily="Poppinsregular" FontSize="15" Padding="15,0,0,0"/>
                    <!--<ImageButton x:Name="btnFiltro" Clicked="btnFiltro_Clicked" Grid.Column="1" HeightRequest="27"  WidthRequest="27" Source="ic_baseline_filterpng.png" />-->
                </Grid>
            </Frame>
        </HorizontalStackLayout>
        <VerticalStackLayout >
            <Grid Padding="20,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>
                <ImageButton Margin="0,10,0,0" Grid.Column="0" VerticalOptions="Start" HorizontalOptions="Start" HeightRequest="25" WidthRequest="25" Source="ic_baseline_search2.svg"/>
                <Entry x:Name="txtBuscar" Grid.Column="1" Margin="0,0,0,0" Text="" TextColor="#04acec" TextChanged="txtBuscar_TextChanged" ClearButtonVisibility="WhileEditing" Placeholder="Nombre de programa..." PlaceholderColor="#04acec" FontSize="16"></Entry>
            </Grid>

            <Line X1="400"
                  Y1="0"
                  X2="0"
                  Opacity="0.5"
                  HeightRequest="10"
                  Margin="20,0,20,0"
                  Stroke="#04acec" />
            <HorizontalStackLayout>

                <Label VerticalOptions="CenterAndExpand" Text="Orden:" TextColor="#04acec" FontSize="15" Padding="20,0,3,0" FontFamily="Poppinsmedium"/>
                <Border x:Name="bCalidad" StrokeThickness="0" StrokeShape="RoundRectangle 40,0,40,0" BackgroundColor="#04acec">
                    <Border.Shadow>
                        <Shadow Brush="gray"
                        Radius="40"
                        Opacity="0.2"/>
                    </Border.Shadow>
                    <Button x:Name="btnCalidad" Clicked="btnCalidad_Clicked" Text="Calidad" TextColor="White" BackgroundColor="Transparent" Padding="25,0,25,0" FontFamily="Poppinlight" FontSize="14" CornerRadius="40" WidthRequest="150"></Button>
                </Border>
                <Border x:Name="bAZ" StrokeThickness="0" StrokeShape="RoundRectangle 0,40,0,40" BackgroundColor="white">
                    <Border.Shadow>
                        <Shadow Brush="gray"
                        Radius="40"
                        Opacity="0.2"/>
                    </Border.Shadow>
                    <Button x:Name="btnAZ" Clicked="btnAZ_Clicked" Text="A-Z" TextColor="#04acec" BackgroundColor="Transparent" Padding="25,0,30,0" FontFamily="Poppinlight" FontSize="14" CornerRadius="40" WidthRequest="150"></Button>
                </Border>

            </HorizontalStackLayout>
            <Label x:Name="lblResultados" VerticalOptions="CenterAndExpand" Text="Resultados:0" TextColor="#04acec" FontSize="15" Padding="20,0,0,10" FontFamily="Poppinsmedium"/>
        </VerticalStackLayout>
        <CollectionView x:Name="collection1"
ItemsUpdatingScrollMode="KeepItemsInView" HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand"  ItemsSource="{Binding ProgramasViewModel}">

            <CollectionView.ItemTemplate >
                <DataTemplate>
                    <StackLayout Padding="20,10,20,10">
                        <Frame BackgroundColor="White" BorderColor="White" CornerRadius="10" HasShadow="True" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" CommandParameter="{Binding Programa}"></TapGestureRecognizer>
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout VerticalOptions="CenterAndExpand" BackgroundColor="White" >
                                <Grid RowDefinitions="Auto,Auto" Padding="0" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" VerticalOptions="CenterAndExpand" Text="{Binding Institucion}" TextColor="#04acec" FontSize="16" Padding="0,0,0,10" FontFamily="robotobold"/>
                                    <Image Grid.Column="1" Source="logo_color.png" WidthRequest="40" HeightRequest="40" IsVisible="{Binding AcreditadosVisible}"></Image>
                                </Grid>

                                <Label VerticalOptions="CenterAndExpand" Text="{Binding Programa}" TextColor="#7c7c80" FontFamily="robotobold" FontSize="16"/>
                                <Label VerticalOptions="CenterAndExpand" Text="{Binding TipoPrograma}" TextColor="#7c7c80" FontFamily="robotobold" FontSize="12"/>
                                <Label VerticalOptions="CenterAndExpand" Text="Resoluciones de acreditación:" TextColor="#7c7c80" Margin="0,8,0,5" FontFamily="robotobold" FontSize="12" IsVisible="{Binding AcreditadosVisible}"/>
                                <CollectionView HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand" ItemsSource="{Binding Resoluciones}" IsVisible="{Binding AcreditadosVisible}">
                                    <CollectionView.ItemTemplate >
                                        <DataTemplate>
                                            <HorizontalStackLayout>
                                                <Label HorizontalOptions="Start" Text="{Binding Resolucion}" FontFamily="robotolight" TextColor="#7c7c80" FontSize="12" />
                                                <Label HorizontalOptions="Start" Text="{Binding Fechas}" FontFamily="robotolight" TextColor="#04acec" FontSize="12" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Label VerticalOptions="CenterAndExpand" Text="{Binding LocalesAcreditados}" TextColor="#04acec" IsVisible="{Binding AcreditadosVisible}" Padding="0,8,0,10" FontFamily="robotobold" FontSize="12"/>
                                <Label VerticalOptions="CenterAndExpand" Text="{Binding LocalesAcreditados}" TextColor="#7c7c80" IsVisible="{Binding AcreditadosVisible2}" FontFamily="robotobold" FontSize="12"/>
                                <CollectionView HorizontalOptions="EndAndExpand" VerticalOptions="FillAndExpand" ItemsSource="{Binding Locales}">
                                    <CollectionView.ItemTemplate >
                                        <DataTemplate>
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Label Grid.Column="0" HorizontalOptions="Start" WidthRequest="300" Text="{Binding Direccion}" FontFamily="robotolight" TextColor="#7c7c80" FontSize="12" />
                                                <Label Grid.Column="0" HorizontalOptions="Start" WidthRequest="150" Text="{Binding Departemento}" FontFamily="robotolight" TextColor="#7c7c80" FontSize="12" Padding="0,15,0,0" />
                                                <Label Grid.Column="1" HorizontalOptions="End" VerticalOptions="End" Text="{Binding Distancia}" FontFamily="robotolight" TextColor="#04acec" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>