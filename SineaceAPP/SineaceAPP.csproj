	<PropertyGroup>
		<TargetFrameworks>net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>SineaceAPP</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Display name -->
		<ApplicationTitle>SineaceAPP</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.sineaceapp</ApplicationId>
		<ApplicationIdGuid>19cc9132-6820-412b-9a65-28a81787eadd</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

		<!-- RNF-PORT-001 / AD-01: iOS 15.0. AD-24: la comparacion es-PE y la regla B dependen de ICU: sin globalizacion invariante -->
		<InvariantGlobalization>false</InvariantGlobalization>

		<!-- AD-05: entorno de configuracion (Produccion por defecto). Para pruebas: dotnet build -p:SineaceEntorno=Pruebas -->
		<SineaceEntorno Condition="'$(SineaceEntorno)' == ''">Produccion</SineaceEntorno>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
