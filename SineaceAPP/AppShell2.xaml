<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SineaceAPP.AppShell2"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SineaceAPP.Pages.Mapa"
    xmlns:local2="clr-namespace:SineaceAPP.Pages.Instituciones"
    xmlns:controls="clr-namespace:SineaceAPP.Pages.Otros"
    Shell.FlyoutBehavior="Flyout"
    FlyoutIcon="dotnet_bot.png"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    >
    <Shell.FlyoutHeader>
        <AbsoluteLayout Background="#04acec" Padding="80,20" HeightRequest="90">
            <Image Source="logo_blanco_3.png" WidthRequest="150" HeightRequest="60"></Image>
        </AbsoluteLayout>

    </Shell.FlyoutHeader>

    <Shell.FlyoutContent>
        <controls:MenuControl />
    </Shell.FlyoutContent>
    
    <Shell.FlyoutFooterTemplate>

        <DataTemplate>

            <StackLayout>
                <Image Source="apple.png"
                       HeightRequest="30"
                       WidthRequest="30"
                       HorizontalOptions="Center"></Image>
                <Label Text="iOS"
                       TextColor="Black"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />


            </StackLayout>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems" Route="ParentRoute">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:Mapa2}"
            Route="MainPage" />
    </FlyoutItem>
</Shell>

